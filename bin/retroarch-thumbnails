#!/usr/bin/env python3
"""Hämta omslagsbilder från libretros bildserver till RetroArchs spellistor.

Serverns filnamn följer No-Intro ("Spel (USA) (En,Fr,De).png") medan
spellistornas etiketter är städade, så matchningen sker på normaliserad titel.
Bilden sparas under etikettens namn - det är så RetroArch slår upp den.

  retroarch-thumbnails                  # alla spellistor
  retroarch-thumbnails "Game Boy"       # bara matchande system
"""
import json, pathlib, re, sys, urllib.parse, urllib.request, concurrent.futures

BASE = "https://thumbnails.libretro.com"
PL = pathlib.Path.home() / ".config/retroarch/playlists"
OUT = pathlib.Path.home() / ".config/retroarch/thumbnails"
# Saknas omslag duger titelskärm eller skärmdump - allt hamnar i
# Named_Boxarts eftersom RetroArch inte faller tillbaka på egen hand.
KINDS = ["Named_Boxarts", "Named_Titles", "Named_Snaps"]
# föredra dessa regioner när flera varianter finns
PREF = ["(usa", "(world", "(europe", "(japan"]

# Arkadtitlarna kommer från FBNeo-/MAME-databaserna, så bilderna ligger i
# motsvarande bildarkiv - inte bara i systemets eget.
REPOS = {
    "SNK - Neo Geo": ["SNK - Neo Geo", "FBNeo - Arcade Games", "MAME"],
    "MAME": ["MAME", "FBNeo - Arcade Games"],
}


def norm(s: str) -> str:
    s = s.lower()
    s = re.sub(r"\.(png|zip|7z|nes|sfc|smc|md|gen|gba|nds|bin|cue|pce|sms|n64|z64)$", "", s)
    s = re.sub(r"^\s*\d{3,5}\s*[-_.]\s*", "", s)   # katalognummer: "2420 - Nanashi..."
    s = re.sub(r"[\(\[].*?[\)\]]", " ", s)          # regioner, språk, dumptaggar
    s = re.sub(r"\b(the|a|an)\b", " ", s)
    s = re.sub(r"[^a-z0-9]+", " ", s)
    return re.sub(r"\s+", " ", s).strip()


def index(system: str, kind: str) -> dict:
    url = f"{BASE}/{urllib.parse.quote(system)}/{kind}/"
    try:
        with urllib.request.urlopen(url, timeout=60) as r:
            html = r.read().decode("utf-8", "replace")
    except Exception:
        return {}
    out = {}
    for href in re.findall(r'href="([^"]+\.png)"', html):
        name = urllib.parse.unquote(href)
        out.setdefault(norm(name), []).append(name)
    return out


def pick(cands: list) -> str:
    for p in PREF:
        for c in cands:
            if p in c.lower():
                return c
    return cands[0]


def main():
    only = sys.argv[1].lower() if len(sys.argv) > 1 else None
    grand_ok = grand_miss = 0
    for lpl in sorted(PL.glob("*.lpl")):
        if lpl.stem.startswith("content_") or (only and only not in lpl.stem.lower()):
            continue
        items = json.loads(lpl.read_text(encoding="utf-8"))["items"]
        dest_final = OUT / lpl.stem / "Named_Boxarts"
        for repo, kind in [(r, k) for r in REPOS.get(lpl.stem, [lpl.stem]) for k in KINDS]:
            idx = index(repo, kind)
            if not idx:
                continue
                continue
            dest = dest_final
            dest.mkdir(parents=True, exist_ok=True)
            todo = []
            for it in items:
                target = dest / (re.sub(r'[/\\]', "_", it["label"]) + ".png")
                if target.exists():
                    continue
                key = norm(it["label"])
                cands = idx.get(key)
                if not cands and len(key) >= 8:
                    # Paketets filnamn är ibland avkortade ("Dokapon" ->
                    # "Dokapon Monster Hunter"). Acceptera bara entydiga träffar.
                    pre = [v for k, v in idx.items() if k.startswith(key + " ")]
                    if len(pre) == 1:
                        cands = pre[0]
                if cands:
                    todo.append((pick(cands), target))
            ok = 0
            def fetch(job):
                name, target = job
                url = f"{BASE}/{urllib.parse.quote(repo)}/{kind}/{urllib.parse.quote(name)}"
                try:
                    with urllib.request.urlopen(url, timeout=60) as r:
                        data = r.read()
                    target.write_bytes(data)
                    return True
                except Exception:
                    return False
            with concurrent.futures.ThreadPoolExecutor(max_workers=8) as ex:
                ok = sum(ex.map(fetch, todo))
            have = len(list(dest.glob("*.png")))
            miss = len(items) - have
            grand_ok += have; grand_miss += max(miss, 0)
            print(f"  {lpl.stem:<48} {have:>5}/{len(items)} omslag", flush=True)
    print(f"\n  {grand_ok} omslag totalt, {grand_miss} spel utan bild")


if __name__ == "__main__":
    main()
